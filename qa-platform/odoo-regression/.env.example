# ---- Odoo 15 target -------------------------------------------------------
ODOO15_URL=http://localhost:8015
ODOO15_DB=odoo15_test
ODOO15_USERNAME=admin
ODOO15_PASSWORD=admin

# ---- Odoo 19 target -------------------------------------------------------
ODOO19_URL=http://localhost:8019
ODOO19_DB=odoo19_test
ODOO19_USERNAME=admin
ODOO19_PASSWORD=admin

# ---- Browser automation ----------------------------------------------------
# HEADLESS=false → watch the real browser perform the workflow
HEADLESS=true
SLOWMO=0                  # ms of slow-motion per action (nice with HEADLESS=false)
TIMEOUT_MS=30000
NAV_TIMEOUT_MS=60000
TRACE=retain-on-failure   # off | on | retain-on-failure
VIDEO=false
SCREENSHOT_ON_SUCCESS=true

# ---- Runner ----------------------------------------------------------------
RUNNER_HOST=127.0.0.1
RUNNER_PORT=8000
